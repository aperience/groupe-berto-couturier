# Dépendances Composer (composer.lock est versionné : builds reproductibles)
/vendor/

# Node modules (package-lock.json est versionné : builds reproductibles)
node_modules/
yarn.lock

# Build
/dist/
/build/

# Traductions du thème
# Le .pot (gabarit) et les .po (traductions) sont versionnés ;
# tout le reste est recompilé par `npm run build`.
/languages/*.mo
/languages/*.l10n.php

# Les motifs ci-dessus sont ancrés à la racine, et c'est volontaire : les
# traductions du socle vivent dans vendor/deefuse/wp-theme-core/languages/ et
# suivent la règle inverse — l'installation d'un package Composer ne déclenche
# aucun build, ses fichiers compilés sont donc livrés avec le tag. Ne jamais
# élargir ces motifs en `languages/*.mo` ou `**/languages/*.mo`.

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
.cache/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
