{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "couturier/compact-cta",
	"title": "Appel à action compact",
	"category": "design",
	"icon": "megaphone",
	"description": "Bandeau clair arrondi, fond au choix : titre et texte à gauche, un ou deux boutons à droite.",
	"keywords": [ "cta", "bouton", "bandeau", "appel" ],
	"textdomain": "couturier",
	"attributes": {
		"background": {
			"type": "string",
			"enum": [ "petrol-100", "peach-300", "orange-100", "petrol-50", "neutral-50" ],
			"default": "petrol-100"
		}
	},
	"supports": {
		"html": false
	},
	"example": {
		"viewportWidth": 1200,
		"innerBlocks": [
			{ "name": "core/heading", "attributes": { "level": 2, "content": "Vous cherchez une formation professionnelle ?" } },
			{ "name": "core/paragraph", "attributes": { "content": "Un particulier peut suivre une formation FIMO, FCO ou CACES, par exemple en reconversion." } },
			{
				"name": "core/buttons",
				"innerBlocks": [
					{ "name": "core/button", "attributes": { "text": "Découvrir Formation Pro", "className": "is-style-deep", "hasArrow": true } },
					{ "name": "core/button", "attributes": { "text": "Être rappelé" } }
				]
			}
		]
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
