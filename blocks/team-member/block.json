{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "couturier/team-member",
	"title": "Membre de l'équipe",
	"category": "design",
	"icon": "admin-users",
	"description": "Carte d'un contact : photo ou fond de couleur, nom affiché et fonction.",
	"parent": [
		"couturier/team"
	],
	"textdomain": "couturier",
	"attributes": {
		"contactId": {
			"type": "integer"
		},
		"background": {
			"type": "string",
			"enum": [
				"peach-300",
				"petrol-100",
				"orange-100",
				"petrol-50"
			],
			"default": "peach-300"
		},
		"focalPoint": {
			"type": "object"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
