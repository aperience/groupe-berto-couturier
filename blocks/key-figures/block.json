{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "couturier/key-figures",
	"title": "Chiffres clés",
	"category": "design",
	"icon": "chart-bar",
	"description": "Carte de 2 à 4 chiffres clés, chacun avec sa valeur et son libellé.",
	"keywords": [ "chiffres", "statistiques", "nombres", "stats" ],
	"textdomain": "couturier",
	"attributes": {
		"items": {
			"type": "array",
			"source": "query",
			"selector": "li.wp-block-couturier-key-figures__item",
			"query": {
				"value": {
					"type": "string",
					"source": "html",
					"selector": ".wp-block-couturier-key-figures__value"
				},
				"label": {
					"type": "string",
					"source": "html",
					"selector": ".wp-block-couturier-key-figures__label"
				}
			},
			"default": [
				{ "value": "", "label": "" },
				{ "value": "", "label": "" },
				{ "value": "", "label": "" },
				{ "value": "", "label": "" }
			],
			"role": "content"
		}
	},
	"supports": {
		"html": false
	},
	"example": {
		"viewportWidth": 1200,
		"attributes": {
			"items": [
				{ "value": "1963", "label": "Depuis cette année, l’auto-école accompagne les candidats" },
				{ "value": "80 %", "label": "de réussite au permis B" },
				{ "value": "4,8 / 5", "label": "avis Google" },
				{ "value": "2130", "label": "stagiaires formés par an" }
			]
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
