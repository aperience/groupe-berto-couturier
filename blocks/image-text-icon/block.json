{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "couturier/image-text-icon",
	"title": "Icône",
	"category": "design",
	"icon": "star-filled",
	"description": "Pictogramme (SVG de la médiathèque, peint en pétrole), libellé et lien facultatif.",
	"textdomain": "couturier",
	"parent": [ "couturier/image-text-icons" ],
	"attributes": {
		"iconId": {
			"type": "number"
		},
		"link": {
			"type": "object"
		},
		"label": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-couturier-image-text-icon__label",
			"role": "content"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
