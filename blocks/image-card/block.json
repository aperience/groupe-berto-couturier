{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "couturier/image-card",
	"title": "Carte illustrée",
	"category": "design",
	"icon": "format-image",
	"description": "Une carte : image de fond estompée, pictogramme facultatif dans une bulle blanche, titre H3 et texte.",
	"textdomain": "couturier",
	"parent": [ "couturier/image-cards" ],
	"attributes": {
		"imageId": {
			"type": "number"
		},
		"focalPoint": {
			"type": "object"
		},
		"iconId": {
			"type": "number"
		},
		"text": {
			"type": "string",
			"source": "html",
			"selector": "p.wp-block-couturier-image-card__text",
			"role": "content"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
