{% extends "base.twig" %}

{% block content %}
    <div class="container">
        {# Contenu de la page des articles (héros…). Le <h1> est celui du héros ; sans héros, le titre. #}
        {% if post %}
            {% if not function('has_block', 'couturier/page-hero', post.id) %}
                <h1>{{ post.title }}</h1>
            {% endif %}
            {{ post.content|raw }}
        {% endif %}

        {# `for … else` et non `if posts` : un `PostQuery` de Timber est toujours
           « vrai », même vide — la branche `else` d'un `if` ne s'afficherait jamais. #}
        {% for article in posts %}
            <article class="{{ article.class }}">
                <h2>
                    <a href="{{ article.link }}">{{ article.title }}</a>
                </h2>
                <div class="entry-content">
                    {{ article.excerpt({ read_more: __('Lire la suite', 'couturier') })|raw }}
                </div>
            </article>
        {% else %}
            <p>{{ __('Aucun contenu trouvé.', 'couturier') }}</p>
        {% endfor %}
    </div>
{% endblock %}
