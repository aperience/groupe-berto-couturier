{% extends "base.twig" %}

{% block content %}
    <div class="container">
        {# Contenu de la page des articles (héros…). Le <h1> est celui du héros ; sans héros, le titre. #}
        {% if post %}
            {% if not function('has_block', 'couturier/page-hero', post.id) %}
                <h1>{{ post.title }}</h1>
            {% endif %}
            {{ post.content|raw }}
        {% endif %}

        {% include 'partials/post-list.twig' with { posts: posts, blog: blog } only %}
    </div>
{% endblock %}
