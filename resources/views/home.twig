{% extends "base.twig" %}

{% block content %}
    <div class="container">
        {# Contenu de la page des articles (héros…). Le <h1> est celui du héros ; sans héros, le titre. #}
        {% if post %}
            {% if not function('has_block', 'couturier/page-hero', post.id) %}
                <h1>{{ post.title }}</h1>
            {% endif %}
            {{ post.content|raw }}
        {% endif %}

        {# `for … else` et non `if posts` : un `PostQuery` de Timber est toujours
           « vrai », même vide — la branche `else` d'un `if` ne s'afficherait jamais. #}
        {# Page 1 : l'article le plus récent en grande carte, les suivants en grille. #}
        {% set first_page = posts.pagination.current|default(1) == 1 %}
        {% for article in posts %}
            {% if loop.first %}<ul class="post-list">{% endif %}
            {% include 'partials/post-card.twig' with { article: article, featured: first_page and loop.first } only %}
            {% if loop.last %}</ul>{% endif %}
        {% else %}
            <p>{{ __('Aucun article pour le moment.', 'couturier') }}</p>
        {% endfor %}
    </div>
{% endblock %}
