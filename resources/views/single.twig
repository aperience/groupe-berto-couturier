{% extends "base.twig" %}

{% block content %}
    <article class="{{ post.class }}">
        <div class="container">
            {# Le <h1> du billet est celui du héros de page s'il en a un ; sinon, le titre. #}
            {% if not function('has_block', 'couturier/page-hero', post.id) %}
                <h1>{{ post.title }}</h1>
            {% endif %}
            {# Contenu enfant direct du `.container`, comme dans `page.twig` : les styles
               des blocs de premier niveau (titres libres…) visent `.container > …`. #}
            {{ post.content|raw }}
        </div>
    </article>
{% endblock %}
