{% extends "base.twig" %}

{% block content %}
    <div class="container">
        <header class="archive-header">
            {{ breadcrumb|raw }}
            <h1 class="archive-header__title">{{ term.name }}</h1>
            {% if term.description %}
                <p class="archive-header__text">{{ term.description }}</p>
            {% endif %}
        </header>

        {% include 'partials/post-list.twig' with { posts: posts, blog: blog } only %}
    </div>
{% endblock %}
