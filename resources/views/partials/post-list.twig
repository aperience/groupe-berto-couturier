{#
 # Liste des articles : filtre par catégorie, cartes, pagination.
 # Partagée par la page des articles (`home.twig`) et les archives de catégorie
 # (`category.twig`).
 #
 # Paramètres : `posts` (PostQuery), `blog` (contexte de `Blog\BlogContext`).
 #}
{% if blog.categories|length > 1 %}
    <nav class="category-filter" aria-label="{{ __('Catégories des articles', 'couturier') }}">
        <ul class="category-filter__list">
            <li>
                <a class="category-filter__link" href="{{ blog.url }}"{{ blog.all_current ? ' aria-current="page"' }}>{{ __('Tous les articles', 'couturier') }}</a>
            </li>
            {% for category in blog.categories %}
                <li>
                    <a class="category-filter__link" href="{{ category.url }}"{{ category.current ? ' aria-current="page"' }}>{{ category.name }}</a>
                </li>
            {% endfor %}
        </ul>
        {# Mobile (sous lg) : liste déroulante, affichée par category-filter.js
           à la place des pastilles (sans JS, les pastilles restent). Pas de
           navigation au changement de choix (WCAG 3.2.2) : bouton « Afficher ». #}
        <form class="category-filter__form" hidden>
            <label class="visually-hidden" for="category-filter-select">{{ __('Catégorie', 'couturier') }}</label>
            <span class="category-filter__field">
                <select class="category-filter__select" id="category-filter-select">
                    <option value="{{ blog.url }}"{{ blog.all_current ? ' selected' }}>{{ __('Tous les articles', 'couturier') }}</option>
                    {% for category in blog.categories %}
                        <option value="{{ category.url }}"{{ category.current ? ' selected' }}>{{ category.name }}</option>
                    {% endfor %}
                </select>
            </span>
            <button class="category-filter__submit" type="submit">{{ __('Afficher', 'couturier') }}</button>
        </form>
    </nav>
{% endif %}

{# Page 1 : l'article le plus récent en grande carte, les suivants en grille.
   `for … else` et non `if posts` : un `PostQuery` de Timber est toujours
   « vrai », même vide. #}
{% set first_page = posts.pagination.current|default(1) == 1 %}
{% for article in posts %}
    {% if loop.first %}<ul class="post-list">{% endif %}
    {% include 'partials/post-card.twig' with { article: article, featured: first_page and loop.first } only %}
    {% if loop.last %}</ul>{% endif %}
{% else %}
    <p class="post-list-empty">{{ __('Aucun article pour le moment.', 'couturier') }}</p>
{% endfor %}

{% include 'partials/pagination.twig' with { pagination: posts.pagination({ mid_size: 1 }) } only %}
