<p>{{ __("Voici les blocs créés pour le site. Chacun s'ajoute dans l'éditeur d'une page avec le bouton « + », et ses réglages se trouvent dans le panneau de droite, onglet « Bloc ».", 'couturier') }}</p>
<p>{{ __("Commun à tous : le réglage « Rapprocher du bloc précédent » (panneau « Espacement ») réduit l'écart avec le bloc du dessus, pour que deux blocs forment une seule section.", 'couturier') }}</p>

<nav class="couturier-catalog__toc" aria-label="{{ __('Sommaire du catalogue', 'couturier') }}">
    {% for group, blocks in groups %}
        <div>
            <h2>{{ group_labels[group] }}</h2>
            <ul>
                {% for block in blocks %}
                    <li><a href="#bloc-{{ block.slug }}">{{ block.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
    {% endfor %}
</nav>

{% for group, blocks in groups %}
    {% for block in blocks %}
        <section class="couturier-catalog__block" id="bloc-{{ block.slug }}">
            <h2>{{ block.title }} <span class="couturier-catalog__group">{{ group_labels[group] }}</span></h2>
            {% if block.image_url %}
                {# translators: %s : nom du bloc. #}
                <img class="couturier-catalog__image" src="{{ block.image_url }}" alt="{{ __('Aperçu du bloc « %s »', 'couturier')|format(block.title) }}" loading="lazy">
            {% endif %}
            <p class="couturier-catalog__description">{{ block.description }}</p>
            {% if settings[block.slug] is defined %}
                <h3>{{ __('Réglages et contenu', 'couturier') }}</h3>
                <ul class="couturier-catalog__settings">
                    {% for item in settings[block.slug] %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            <p class="couturier-catalog__links">
                {% if block.demo_url %}
                    <a href="{{ block.demo_url|e('esc_url')|raw }}" target="_blank">{{ __('Voir sur le site', 'couturier') }}<span class="screen-reader-text"> {{ __('(nouvel onglet)', 'couturier') }}</span></a>
                    ·
                {% endif %}
                <a href="#wpbody-content">{{ __('Haut de page', 'couturier') }}</a>
            </p>
        </section>
    {% endfor %}
{% endfor %}

<style>
    .couturier-catalog__toc { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px 24px; margin: 16px 0 32px; padding: 16px 20px; background: #fff; border: 1px solid #dcdcde; }
    .couturier-catalog__toc h2 { margin: 0 0 6px; font-size: 14px; }
    .couturier-catalog__toc ul { margin: 0; }
    .couturier-catalog__block { margin: 0 0 32px; padding: 20px 24px; background: #fff; border: 1px solid #dcdcde; scroll-margin-top: 48px; }
    .couturier-catalog__block > h2 { margin-top: 0; }
    .couturier-catalog__group { margin-left: 8px; font-size: 12px; font-weight: 400; color: #646970; }
    .couturier-catalog__image { display: block; max-width: 100%; height: auto; margin: 0 0 16px; border: 1px solid #dcdcde; border-radius: 4px; }
    .couturier-catalog__description { font-size: 14px; font-style: italic; }
    .couturier-catalog__settings { list-style: disc; padding-left: 20px; }
</style>
