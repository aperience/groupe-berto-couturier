{#
    Aide de l'admin, onglet « Sarbacane » (feature Sarbacane\SarbacaneHelp).
    Données : `constants` (nom → définie ?), `configured`, `list_name`, `default_list`,
    `excluded`, `is_admin`, `debug_url`, `import_url`.
#}
<h2>{{ __('Envoi des formulaires vers Sarbacane', 'couturier') }}</h2>
<p>{{ __("Chaque formulaire Ninja Forms envoyé sur le site est transmis à Sarbacane, dans une liste unique. Si la personne y figure déjà (même e-mail), sa fiche est mise à jour plutôt que créée en double.", 'couturier') }}</p>
<p>
    {% if configured %}
        <strong>{{ __('État : actif.', 'couturier') }}</strong>
        {{ __('Liste utilisée :', 'couturier') }} <code>{{ list_name }}</code>
    {% else %}
        <strong>{{ __("État : inactif. Les clés Sarbacane ne sont pas renseignées dans wp-config.php : aucun formulaire n'est envoyé.", 'couturier') }}</strong>
    {% endif %}
</p>

<h2>{{ __('Configuration dans wp-config.php', 'couturier') }}</h2>
<p>{{ __("Les clés d'accès ne sont pas enregistrées dans le thème ni dans l'administration : elles se déclarent dans le fichier wp-config.php du serveur, avant la ligne « C'est tout, ne touchez pas à ce qui suit ! ». Elles se trouvent dans le compte Sarbacane (paramètres de l'API).", 'couturier') }}</p>
<pre><code>define('SARBACANE_ACCOUNT_ID', 'votre_account_id');
define('SARBACANE_API_KEY', 'votre_api_key');
define('SARBACANE_LIST', 'TEST-COUTURIER Formulaires'); // {{ __('facultative', 'couturier') }}</code></pre>
<table class="widefat striped" style="max-width: 900px">
    <thead>
        <tr>
            <th scope="col">{{ __('Constante', 'couturier') }}</th>
            <th scope="col">{{ __('Rôle', 'couturier') }}</th>
            <th scope="col">{{ __('Sur ce site', 'couturier') }}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>SARBACANE_ACCOUNT_ID</code></td>
            <td>{{ __('Identifiant du compte Sarbacane. Obligatoire.', 'couturier') }}</td>
            <td>{{ constants.SARBACANE_ACCOUNT_ID ? __('Définie', 'couturier') : __('Absente', 'couturier') }}</td>
        </tr>
        <tr>
            <td><code>SARBACANE_API_KEY</code></td>
            <td>{{ __("Clé de l'API Sarbacane. Obligatoire.", 'couturier') }}</td>
            <td>{{ constants.SARBACANE_API_KEY ? __('Définie', 'couturier') : __('Absente', 'couturier') }}</td>
        </tr>
        <tr>
            <td><code>SARBACANE_LIST</code></td>
            {# translators: %s : nom de la liste du client. #}
            <td>{{ __('Nom de la liste qui reçoit les contacts. Facultative : sans elle, la liste du client « %s ».', 'couturier')|format(default_list) }}</td>
            <td>{{ constants.SARBACANE_LIST ? __('Définie', 'couturier') : __('Absente (liste du client)', 'couturier') }}</td>
        </tr>
    </tbody>
</table>
<p>{{ __("Hors production (site local, préproduction), indiquez toujours une liste de test dans SARBACANE_LIST : sinon, chaque essai de formulaire ajoute un contact dans la vraie liste du client. La liste est créée automatiquement chez Sarbacane si elle n'existe pas.", 'couturier') }}</p>

<h2>{{ __('Ce qui est envoyé', 'couturier') }}</h2>
<ul class="ul-disc">
    <li>{{ __("Tous les formulaires Ninja Forms du site sont concernés, sans réglage à faire.", 'couturier') }}</li>
    <li>{{ __("Un formulaire n'est envoyé que s'il contient une adresse e-mail ou un numéro de téléphone. Un numéro commençant par 0 est converti au format international (+33).", 'couturier') }}</li>
    <li>{{ __("Les champs du formulaire deviennent des champs de la liste Sarbacane, du même nom. Un champ qui n'existe pas encore chez Sarbacane y est créé automatiquement.", 'couturier') }}</li>
    <li>{{ __("Certains champs sont regroupés : « Code postal » et « Ville » vont dans « Code postal et ville » ; tout champ dont le libellé contient « question » ou « message » va dans « Question ». Un champ « Prénom et nom » est aussi découpé en « Prénom » et « Nom ».", 'couturier') }}</li>
    <li>{{ __('Pour respecter le RGPD (minimisation des données), ces champs ne sont jamais envoyés :', 'couturier') }} {% for field in excluded %}« {{ field|capitalize }} »{{ not loop.last ? ', ' }}{% endfor %}.</li>
    <li>{{ __("Les cases à cocher sont envoyées en « Oui » / « Non », les listes de choix avec le libellé de l'option choisie.", 'couturier') }}</li>
    <li>{{ __("Chaque contact reçoit aussi : « Formulaire » (titre du formulaire), « ID formulaire » (NF-numéro), « Campagne » et « Date de la demande ».", 'couturier') }}</li>
    <li>{{ __("La campagne est déduite du titre du formulaire, débarrassé de « Formulaire », « Landing page », « Campagne » et « Spécial » : « Formulaire campagne spécial Noël 2026 » donne « Noël 2026 ». Nommez donc vos formulaires de campagne en conséquence.", 'couturier') }}</li>
    <li>{{ __("Suivi des ouvertures d'e-mails : si le formulaire contient une case dont la clé de champ est consentement_suivi_emails et qu'elle est cochée, le consentement au suivi est transmis à Sarbacane avec sa date.", 'couturier') }}</li>
</ul>

{% if is_admin %}
    <h2>{{ __('Outils (administrateurs)', 'couturier') }}</h2>
    <ul class="ul-disc">
        <li>
            <a href="{{ debug_url }}">{{ __('Diagnostic', 'couturier') }}</a> :
            {{ __("les 30 derniers événements (envois, erreurs, champs créés), l'identifiant de la liste et ses champs. Les clés ne sont jamais affichées.", 'couturier') }}
        </li>
        <li>
            <a href="{{ import_url }}">{{ __("Simulation de l'import", 'couturier') }}</a> :
            {{ __("compte, formulaire par formulaire, les réponses déjà enregistrées dans Ninja Forms. Rien n'est envoyé.", 'couturier') }}
        </li>
        <li>
            {{ __("Import réel : remplacez sb_import=1 par sb_import=run dans l'adresse de la simulation. Toutes les réponses enregistrées sont alors envoyées à Sarbacane, des plus anciennes aux plus récentes, par lots de 500. Les contacts existants sont mis à jour. À réserver à une reprise de l'historique, après vérification de la liste visée.", 'couturier') }}
        </li>
    </ul>
{% endif %}
