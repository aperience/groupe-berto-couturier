{% extends "base.twig" %}

{% block content %}
    <div class="container">
        {# `for … else` et non `if posts` : un `PostQuery` de Timber est toujours
           « vrai », même vide — la branche `else` d'un `if` ne s'afficherait jamais. #}
        {% for post in posts %}
            <article class="{{ post.class }}">
                <h2>
                    <a href="{{ post.link }}">{{ post.title }}</a>
                </h2>
                <div class="entry-content">
                    {{ post.excerpt|raw }}
                </div>
            </article>
        {% else %}
            <p>{{ __('Aucun contenu trouvé.', 'couturier') }}</p>
        {% endfor %}
    </div>
{% endblock %}
