{% extends "base.twig" %}

{% block content %}
    <div class="container">
        {% if posts %}
            {% for post in posts %}
                <article class="{{ post.class }}">
                    <h2>
                        <a href="{{ post.link }}">{{ post.title }}</a>
                    </h2>
                    <div class="entry-content">
                        {{ post.excerpt|raw }}
                    </div>
                </article>
            {% endfor %}
        {% else %}
            <p>{{ labels.not_found }}</p>
        {% endif %}
    </div>
{% endblock %}
