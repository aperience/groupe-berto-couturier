{#
    Macros des e-mails du projet — à importer dans un fragment d'e-mail :
    {% import 'emails/macros.twig' as email %}

    Composants repris des e-mails Laravel (illuminate/mail) : bouton, puis « subcopy » qui
    redonne l'URL en clair pour qui ne peut pas cliquer.
#}

{#
    Bouton centré « bulletproof » : lien à bordures épaisses de la couleur du fond (la forme
    Laravel), doublé d'une forme VML pour Outlook desktop, qui ignore bordures et arrondis
    sur un <a>. Orange de la charte (#ff6b35), texte petrol/900 à 5,79:1 (WCAG 1.4.3) — le blanc n'y
    tiendrait que 2,8:1.

    @param string url   Destination du bouton.
    @param string label Texte du bouton, déjà traduit.
#}
{% macro button(url, label) %}
    <table role="presentation" align="center" width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%;margin:30px auto;padding:0;text-align:center;">
        <tr>
            <td align="center">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ url|e('esc_url')|raw }}" style="height:44px;v-text-anchor:middle;width:260px;" arcsize="10%" stroke="f" fillcolor="#ff6b35">
                    <w:anchorlock/>
                    <center style="color:#00232d;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;">{{ label }}</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-->
                <a class="email-button" href="{{ url|e('esc_url')|raw }}" style="display:inline-block;overflow:hidden;box-sizing:border-box;background-color:#ff6b35;border-top:10px solid #ff6b35;border-bottom:10px solid #ff6b35;border-left:22px solid #ff6b35;border-right:22px solid #ff6b35;border-radius:4px;box-shadow:0 1px 3px rgba(0,78,99,0.15);color:#00232d;font-size:16px;font-weight:bold;line-height:1.5em;text-decoration:none;-webkit-text-size-adjust:none;">{{ label }}</a>
                <!--<![endif]-->
            </td>
        </tr>
    </table>
{% endmacro %}

{#
    URL de secours sous un bouton, séparée par un filet — à placer en fin de message.

    @param string url   URL du bouton.
    @param string label Texte du bouton, repris dans la phrase d'explication.
#}
{% macro subcopy(url, label) %}
    <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%;margin-top:25px;border-top:1px solid #e0eaec;">
        <tr>
            <td style="padding-top:25px;">
                <p style="margin:0;font-size:14px;line-height:1.5em;color:#3b7787;text-align:left;">
                    {# translators: %s : texte du bouton. #}
                    {{ __('Si le bouton « %s » ne fonctionne pas, copiez l’adresse ci-dessous dans votre navigateur :', 'couturier')|format(label) }}
                    <span style="word-break:break-all;"><a href="{{ url|e('esc_url')|raw }}" style="color:#004e63;text-decoration:underline;">{{ url }}</a></span>
                </p>
            </td>
        </tr>
    </table>
{% endmacro %}
